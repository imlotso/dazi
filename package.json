{
  "name": "dazi",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/prepare-sites-build.mjs && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist/server/app.js",
    "preview": "vite preview",
    "dev:api": "tsx watch server/index.ts",
    "start": "node dist/server/app.js",
    "test": "vitest run --exclude tests/sites-worker.test.mjs",
    "typecheck": "tsc --noEmit",
    "test:sites": "node --test tests/sites-worker.test.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/static": "^10.1.10",
    "@phosphor-icons/react": "^2.1.10",
    "argon2": "^0.45.2",
    "better-sqlite3": "^13.1.1",
    "fastify": "^5.12.8",
    "nodemailer": "^10.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.10",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~6.0.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
